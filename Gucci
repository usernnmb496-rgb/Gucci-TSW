    local NotifyInfo  = Tabs.Notify:AddRightGroupbox("Info", "info")

    -- ─── Kick Notify ───
    local kickNotifyConnection = nil

    local function getClosestPlayerNotify(pos)
        if not pos then return nil end
        local closestPlayer, minDistance = nil, math.huge
        for _, player in pairs(Players:GetPlayers()) do
            if player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local distance = (hrp.Position - pos).Magnitude
                    if distance < minDistance then
                        minDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
        return closestPlayer
    end

    NotifyGroup:AddCheckbox("KickNotify", {
        Text = "Kick Notify",
        Default = false,
        Callback = function(Value)
            if Value then
                kickNotifyConnection = Workspace.ChildAdded:Connect(function(obj)
                    local kickObjectNames = {
                        ["blackholekick"] = true,
                        ["blackholekicktweens(old)"] = true,
                        ["blackholekicktweens"] = true,
                        ["jhole"] = true,
                        ["blackhole"] = true,
                        ["black_hole"] = true,
                        ["voidhole"] = true,
                        ["singularity"] = true,
                    }
                    if not obj.Name or not kickObjectNames[obj.Name:lower()] then return end
                    task.wait(0.1)

                    local pos
                    if obj:IsA("BasePart") then
                        pos = obj.Position
                    else
                        local part = obj:FindFirstChildWhichIsA("BasePart", true)
                        if part then pos = part.Position end
                    end
                    if not pos then return end

                    local closestPlayer = getClosestPlayerNotify(pos)
                    if closestPlayer then
                        local displayName = closestPlayer.DisplayName or "Unknown"
                        local realName    = closestPlayer.Name or "Unknown"
                        Notify("KICK DETECTED", "Player: " .. realName .. " (" .. displayName .. ")", 5)
                    end
                end)
                Notify("Notify", "Kick Notify enabled", 2)
            else
                if kickNotifyConnection then
                    kickNotifyConnection:Disconnect()
                    kickNotifyConnection = nil
                end
                Notify("Notify", "Kick Notify disabled", 2)
            end
        end
    })

    NotifyGroup:AddDivider()

    -- ─── Packet Lag Notify ───
    local packetLagNotifyEnabled = false
    local lastLagSource = false
    local packetLagConnection = nil

    local function GetSizeMB(StringLength)
        return StringLength / (1024 * 1024)
    end

    local function StartPacketLagDetector()
        if packetLagConnection then
            packetLagConnection:Disconnect()
            packetLagConnection = nil
        end
        packetLagConnection = ReplicatedStorage.GrabEvents.ExtendGrabLine.OnClientEvent:Connect(function(arg1, data)
            if typeof(data) == "string" and not lastLagSource and packetLagNotifyEnabled then
                lastLagSource = true
                local StringLen = string.len(data)
                if StringLen > 300 then
                    local SizeRounded = math.round(GetSizeMB(StringLen) * 1000) / 1000
                    Notify("PACKET LAG DETECTED",
                        "Source: " .. tostring(arg1) .. "\nSize: " .. tostring(SizeRounded) .. " MB", 5)
                end
                task.delay(5, function()
                    lastLagSource = false
                end)
            end
        end)
    end

    NotifyGroup:AddCheckbox("PacketLagNotify", {
        Text = "Packet Lag Notify",
        Default = false,
        Callback = function(Value)
            packetLagNotifyEnabled = Value
            if Value then
                StartPacketLagDetector()
                Notify("Notify", "Packet Lag Notify enabled", 2)
            else
                if packetLagConnection then
                    packetLagConnection:Disconnect()
                    packetLagConnection = nil
                end
                Notify("Notify", "Packet Lag Notify disabled", 2)
            end
        end
    })

    NotifyInfo:AddLabel("Kick Notify")
    NotifyInfo:AddLabel("  → แจ้งเตือนเมื่อมี BlackHole / Kick object")
    NotifyInfo:AddDivider()
    NotifyInfo:AddLabel("Packet Lag Notify")
    NotifyInfo:AddLabel("  → แจ้งเตือนเมื่อมี Packet ขนาดใหญ่")
